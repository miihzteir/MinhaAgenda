rules_version = '2';

// Cole isso nas regras do Firestore (Firebase Console → Firestore Database →
// Regras). Garante que cada pessoa só acessa os próprios dados.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
