# Configuração do Firebase — copie este arquivo para ".env" e preencha com
# os valores do SEU projeto Firebase (Configurações do projeto → Geral →
# "Seus apps" → configuração do SDK).
#
# Estas são chaves PÚBLICAS do Firebase (usadas no navegador) — não são
# segredos e podem ficar em variáveis de ambiente do frontend normalmente.
# Ainda assim, o arquivo ".env" preenchido NÃO deve ser commitado no Git
# (ele já está no .gitignore).
#
# Se você deixar este arquivo sem preencher (ou não criar o .env), a Minha Agenda
# funciona normalmente em MODO LOCAL DE DEMONSTRAÇÃO — sem login nem
# sincronização, apenas com armazenamento no navegador.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
